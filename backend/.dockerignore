# Excluye del contexto de build todo lo que no se necesite dentro de la imagen.
# El objetivo es minimizar el tamaño del contexto y evitar enviar secretos.

venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

.env
.env.*
!.env.example

tests/
*.egg-info/

# Documentación y artefactos de IDE.
*.md
.idea/
.vscode/
