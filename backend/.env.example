# Configuración base del backend AparCáceres.
# Copiar a `backend/.env` y sustituir los valores de ejemplo antes de desplegar.

APP_ENV=production

# Redis Stack usado por catálogo, búsqueda y cachés.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Orígenes web permitidos, separados por comas. Los clientes nativos no
# requieren CORS porque no envían cabecera Origin.
CORS_ORIGINS=http://localhost:5000

# Caché de `/parkings/nearby`, en segundos. El valor 0 la desactiva.
CACHE_NEARBY_TTL=60

# Token exigido en `X-Import-Token` para ejecutar `POST /import-parkings`.
IMPORT_TOKEN=<generate-a-random-token>

# Secreto HS256 usado para emitir y validar tokens de sesión.
FAVORITES_SECRET=<generate-a-random-secret>

# Límites de paginación de endpoints de listado.
DEFAULT_PARKING_LIMIT=100
MAX_PARKING_LIMIT=500

# Controles de observabilidad y protección transversal.
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true

# Nivel raíz del logging JSON: DEBUG, INFO, WARNING, ERROR o CRITICAL.
LOG_LEVEL=INFO

# Resolución de fotos durante el import. Cuando está activa, se consultan
# fichas municipales sin `URL_FOTO` directa y se cachea el resultado por id.
FETCH_PHOTOS=true
PHOTO_FETCH_CONCURRENCY=20
PHOTO_FETCH_TIMEOUT_SECONDS=5.0
PHOTO_CACHE_TTL_SECONDS=7776000