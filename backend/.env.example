# ============================================================
# Configuración del backend AparCáceres.
# Copiar este fichero a `backend/.env` y ajustar para cada entorno.
# ============================================================

# ---------- Entorno lógico ----------
# `development` activa defaults ergonómicos (CORS abierto a localhost).
# `production` (default) deja los defaults estrictos (CORS cerrado).
APP_ENV=development

# ---------- Conexión a Redis Stack (Redis + RediSearch) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------- CORS ----------
# Lista separada por comas con los orígenes web permitidos.
#
# El cliente nativo Android/iOS NO necesita CORS (no envía cabecera Origin).
# Solo hace falta declarar orígenes para Flutter web (`flutter run -d chrome`)
# o cualquier panel web futuro.
#
# Producción (default si no se define la variable y APP_ENV != development):
#   CORS_ORIGINS=https://aparcaceres.app,https://staging.aparcaceres.app
#
# Desarrollo Flutter web (puertos típicos del runner):
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080,http://127.0.0.1:8080
#
# Si dejas la variable sin definir y APP_ENV=development, se aplica esa lista
# de localhost por comodidad. Nunca usar "*" en producción.
CORS_ORIGINS=

# ---------- Caché de /parkings/nearby ----------
# TTL en segundos. Poner 0 para desactivar la caché por completo.
CACHE_NEARBY_TTL=60

# ---------- Reimportación protegida ----------
# Token requerido en `X-Import-Token` para `POST /import-parkings`.
# Vacío = endpoint abierto (solo aceptable en desarrollo local).
IMPORT_TOKEN=

# ---------- Paginación ----------
DEFAULT_PARKING_LIMIT=100
MAX_PARKING_LIMIT=500

# ---------- Logging ----------
# Nivel raíz del logger JSON. Valores: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
