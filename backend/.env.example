# Conexión a Redis Stack (Redis + RediSearch)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# CORS: lista separada por comas de orígenes permitidos.
# En desarrollo usamos "*" (cualquier origen). En producción, poner la URL del cliente.
# Ej.: CORS_ORIGINS=http://localhost:3000,https://aparcaceres.app
CORS_ORIGINS=*

# TTL de la caché de /parkings/nearby en segundos. Poner 0 para desactivar la caché.
CACHE_NEARBY_TTL=60

# Token opcional para POST /import-parkings. Vacío = abierto en desarrollo.
IMPORT_TOKEN=

# Paginación de producción.
DEFAULT_PARKING_LIMIT=100
MAX_PARKING_LIMIT=500
MAX_SEARCH_WINDOW=5000
