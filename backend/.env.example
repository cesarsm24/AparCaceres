# ============================================================
# Configuración del backend AparCáceres.
# Copiar este fichero a `backend/.env` y ajustar para cada entorno.
# ============================================================

# ---------- Entorno lógico ----------
# `production` activa el perfil esperado para el despliegue con Docker Compose.
APP_ENV=production

# ---------- Conexión a Redis Stack (Redis + RediSearch) ----------
# Valor esperado cuando se usa `docker compose up`.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------- CORS ----------
# Lista separada por comas con los orígenes web permitidos.
#
# El cliente nativo Android/iOS NO necesita CORS (no envía cabecera Origin).
# Solo hace falta declarar orígenes para Flutter web (`flutter run -d chrome`)
# o cualquier panel web futuro.
#
# Orígenes permitidos por CORS. Debe incluir el frontend que vaya a hablar
# con la API. Nunca usar "*" en producción.
CORS_ORIGINS=http://localhost:5000

# ---------- Caché de /parkings/nearby ----------
# TTL en segundos. Poner 0 para desactivar la caché por completo.
CACHE_NEARBY_TTL=60

# ---------- Reimportación protegida ----------
# Token requerido en `X-Import-Token` para `POST /import-parkings`.
IMPORT_TOKEN=<generate-a-random-token>

# ---------- Autenticación de favoritos ----------
# Secreto HS256 usado para emitir y validar JWT en `/auth/session` y
# `/users/me/favorites`. Debe definirse explícitamente en cada entorno.
FAVORITES_SECRET=<generate-a-random-secret>

# ---------- Paginación ----------
DEFAULT_PARKING_LIMIT=100
MAX_PARKING_LIMIT=500

# ---------- Observabilidad ----------
# El despliegue de producción activa rate limiting y métricas de forma
# explícita para evitar arranques ambiguos.
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true

# ---------- Logging ----------
# Nivel raíz del logger JSON. Valores: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# ---------- Resolución de fotos durante el import ----------
# El importador descarga las fichas del SIG (`fichatoponimia.php` /
# `fichacalle.php`) para los places sin `URL_FOTO` explícita, extrae la
# `<img src="/fotosOriginales/...">` y la guarda como `imageUrl`. Las URLs
# resueltas (o el "no hay foto" como sentinel vacío) se cachean en
# `parking_photo:{id}` para que un re-import no rescraperar.
#
# `FETCH_PHOTOS=false` desactiva el scraping (los places quedan sin
# `imageUrl` salvo `movilidad_reducida` y `parking_bicis`, que ya traen
# `URL_FOTO` directa en el GeoJSON).
FETCH_PHOTOS=true
# Concurrencia de fetch contra el SIG (semáforo asyncio). 20 mantiene el
# import completo (~7000 features) por debajo del minuto sin saturar.
PHOTO_FETCH_CONCURRENCY=20
# Timeout total por petición HTTP (conexión + lectura).
PHOTO_FETCH_TIMEOUT_SECONDS=5.0
# TTL de la caché por id resuelto. 90 días por defecto. 0 = sin TTL.
PHOTO_CACHE_TTL_SECONDS=7776000
